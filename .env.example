# demo uses clearly labelled fixture evidence; live requires both service keys.
RESEARCH_MODE=demo
LLM_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# auto switches ordinary chat to live after a model key is configured.
CHAT_MODE=auto
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
TAVILY_API_KEY=
DATA_DIR=./data
MAX_RESEARCHERS=3
MAX_SEARCH_CALLS=24
MAX_GAP_ROUNDS=1
RUN_TIMEOUT_SECONDS=600
API_PORT=8000
WEB_PORT=3000

MAX_MODEL_CALLS=80
REPORT_RESERVED_CALLS=4
MCP_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# extra comma-separated values stripped from traces
LANGFUSE_REDACT=
