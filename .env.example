# demo uses clearly labelled fixture evidence; live requires both service keys.
RESEARCH_MODE=demo
LLM_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# auto switches ordinary chat to live after a model key is configured.
CHAT_MODE=auto
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
TAVILY_API_KEY=
DATA_DIR=./data
MAX_RESEARCHERS=3
MAX_SEARCH_CALLS=24
MAX_GAP_ROUNDS=1
RUN_TIMEOUT_SECONDS=600
API_PORT=8000
WEB_PORT=3000

MAX_MODEL_CALLS=80
REPORT_RESERVED_CALLS=4

# Local hash embeddings by default so demo/tests need no key.
# SiliconFlow (https://docs.siliconflow.cn): embeddings POST /v1/embeddings,
# rerank POST /v1/rerank. BAAI/bge-m3 and BAAI/bge-reranker-v2-m3 are listed free.
# Without SILICONFLOW_API_KEY, provider=siliconflow falls back to local-hash-v1 + lexical rerank.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
RERANK_PROVIDER=auto
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_TIMEOUT_SECONDS=45
RERANK_TIMEOUT_SECONDS=45
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
INDEX_VERSION=v1
FTS_RECALL=20
VECTOR_RECALL=20
RERANK_TOP_K=8
MCP_ENABLED=false
